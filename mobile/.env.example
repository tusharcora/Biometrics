EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# How long the app waits for a coach reply (ms). Default 60000, above the server's answer
# budgets. When the backend runs with a raised COACH_LOCAL_BUDGET_MS or COACH_HOSTED_BUDGET_MS,
# set this a few seconds above it.
# EXPO_PUBLIC_COACH_TIMEOUT_MS=75000

# Dev only: set to 1 to launch straight into the character gallery instead of the app.
# EXPO_PUBLIC_CHARACTER_GALLERY=1

# Dev only: a local test account. The sign-in screen then offers a one-tap
# "Sign in as ... (dev)" button (never in release builds). Keep the real values
# in mobile/.env, which is gitignored.
# EXPO_PUBLIC_DEV_SIGN_IN_EMAIL=demo@example.com
# EXPO_PUBLIC_DEV_SIGN_IN_PASSWORD=
