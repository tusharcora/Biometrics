EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# How long the app waits for a coach reply (ms). Default 20000. When the backend runs
# a slow local model with a raised COACH_FAST_BUDGET_MS, set this a few seconds above it.
# EXPO_PUBLIC_COACH_TIMEOUT_MS=95000

# Dev only: set to 1 to launch straight into the orb gallery instead of the app.
# EXPO_PUBLIC_ORB_GALLERY=1
