DATABASE_URL=postgresql://postgres:postgres@localhost:5432/biometrics
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
# 32 raw bytes, base64-encoded, with no "base64:" prefix.
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:3000/health/callback
GOOGLE_HEALTH_WEBHOOK_SECRET=Bearer change-me-to-a-random-value
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=
PORT=3000
# AI Coach kill switch. No hosted LLM provider has cleared the data-handling gate in
# docs/superpowers/specs/2026-09-20-ai-coach-design.md section 5; a model served by a
# local Ollama keeps the data on this machine.
COACH_ENABLED=false
# Coach model: unset = none (every turn gets the server's fallback reply); ollama = local Ollama.
# COACH_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434   # loopback only unless OLLAMA_ALLOW_REMOTE=true
# OLLAMA_MODEL=qwen3.6:35b            # pin the exact tag; must be pulled and tool-capable.
#                                     # Best on the evals (docs/superpowers/notes/local-model-coach-plan.md)
# OLLAMA_FAST_MODEL=                  # optional smaller model for interactive turns
# OLLAMA_THINK=false
# OLLAMA_KEEP_ALIVE=60m
# Turn latency budgets (ms). Defaults 12000 / 60000. qwen3.6:35b answered in 3 s median
# (16 s worst) on an M1 Pro; a dense 27B needs ~90000. Keep the mobile
# EXPO_PUBLIC_COACH_TIMEOUT_MS above the fast budget.
# COACH_FAST_BUDGET_MS=30000
# COACH_SYNTHESIS_BUDGET_MS=120000
# Push delivery for the coach digest: noop (default, delivers nothing) or expo.
# expo sends through the Expo push service; on iOS that needs a paid Apple Developer
# team and an EAS build, so leave it noop until those exist. With expo, POST /me/push-token
# also rejects tokens that are not ExponentPushToken[...] / ExpoPushToken[...].
PUSH_PROVIDER=noop
# Optional Expo access token (only if enhanced push security is enabled on the Expo project).
EXPO_ACCESS_TOKEN=
