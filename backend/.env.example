DATABASE_URL=postgresql://postgres:postgres@localhost:5432/biometrics
REDIS_URL=redis://localhost:6379
# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this API (used in email links), e.g. http://192.168.1.20:3000
BETTER_AUTH_URL=
# Optional: a second Google OAuth client id whose ID tokens are accepted
GOOGLE_IOS_CLIENT_ID=
# Email. Without RESEND_API_KEY, emails are printed to the console (dev only).
EMAIL_FROM=
RESEND_API_KEY=
# 32 raw bytes, base64-encoded, with no "base64:" prefix.
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:3000/health/callback
GOOGLE_HEALTH_WEBHOOK_SECRET=Bearer change-me-to-a-random-value
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=
PORT=3000
# AI Coach kill switch. The default engine is a model served by a local Ollama, which keeps
# the data on this machine; the hosted engine below is opt-in per user, with its own consent.
COACH_ENABLED=false
# Coach model: unset = none (every message fails with model_unavailable: a 503 on the JSON route, an error event on the stream); ollama = local Ollama.
# COACH_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434   # loopback only unless OLLAMA_ALLOW_REMOTE=true
# OLLAMA_MODEL=qwen3.6:35b            # pin the exact tag; must be pulled
# OLLAMA_KEEP_ALIVE=24h               # how long the model stays loaded (a cold load costs ~14 s)
# OLLAMA_TEMPERATURE=0
# OLLAMA_NUM_CTX=8192   # context window; warm-up uses the same value
# Answer budgets for the streamed coach pipeline (ms): local model 45000, hosted 30000.
# COACH_LOCAL_BUDGET_MS=45000
# COACH_HOSTED_BUDGET_MS=30000
# Day summaries (the sentence at the top of the Coach page) written at once by this process,
# on their own 'coach-summary' queue so they never hold up syncing. Default 1, clamped to 1-8.
# COACH_SUMMARY_CONCURRENCY=1
# Hosted engine (opt-in per user, after its own consent screen): Claude through the
# Anthropic API. Offered only when COACH_HOSTED_ENABLED=true AND ANTHROPIC_API_KEY is set.
# The key is server-only; never ship it to the app. Local stays the default engine.
COACH_HOSTED_ENABLED=false
# ANTHROPIC_API_KEY=
# COACH_HOSTED_MODEL=claude-opus-5-5
# Hosted time to first text (ms, default 10000, clamped to 1000-60000). A hosted answer with
# no text by then is dropped and the message is answered by the local model inside what is
# left of COACH_HOSTED_BUDGET_MS, so keep it well under that budget (leave ~15 s+ for a cold local load).
# COACH_HOSTED_FIRST_TEXT_MS=10000
# Push delivery for the coach digest: noop (default, delivers nothing) or expo.
# expo sends through the Expo push service; on iOS that needs a paid Apple Developer
# team and an EAS build, so leave it noop until those exist. With expo, POST /me/push-token
# also rejects tokens that are not ExponentPushToken[...] / ExpoPushToken[...].
PUSH_PROVIDER=noop
# Optional Expo access token (only if enhanced push security is enabled on the Expo project).
EXPO_ACCESS_TOKEN=
